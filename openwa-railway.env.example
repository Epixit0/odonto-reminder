# Usar OpenWA/.env.railway como fuente única (copiar al RAW Editor de Railway)
# Volumen obligatorio: mount /app/data
# NO usar DATABASE_URL — borrarla si Railway la inyectó

SESSION_AUTO_START=true
SESSION_DATA_PATH=/app/data/sessions
MAIN_DATABASE_PATH=/app/data/main.sqlite
DATABASE_NAME=/app/data/openwa.sqlite
API_MASTER_KEY=tu-clave
RAILWAY_RUN_UID=0
