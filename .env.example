# Base de datos
MONGODB_URI=
MONGODB_DB_NAME=odontologia

# Auth del panel (credenciales del consultorio)
AUTH_SECRET=
ADMIN_USER=
ADMIN_PASS=

# WhatsApp vía OpenWA (servicio aparte en ./OpenWA)
# IMPORTANTE: Usar URL pública, NO localhost (Vercel no puede acceder a localhost)
OPENWA_API_URL=https://tu-openwa.railway.app
OPENWA_SESSION_ID=clinica-dental-session
OPENWA_API_KEY=

# Teléfono del odontólogo para recibir notificaciones
OWNER_WHATSAPP_PHONE=+2971234567

# Webhook para recibir mensajes entrantes (opcional, para seguridad extra)
WEBHOOK_SECRET=

# Cron de recordatorios (Vercel o llamada manual)
CRON_SECRET=
